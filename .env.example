# ROS_DOMAIN_ID and DRONE_ID are not set here: they come from /etc/mullet/drone.env (mullet-setup),
# shared by every Compose project on the drone. Every topic is under /$DRONE_ID (uav_N).

# Image tag from this repo's CI. On an aircraft use an immutable tag (sha-<commit> or vX.Y.Z), never main.
MAPPING_TAG=main

# The map to load: ${MAP_DIR}/${MAP_SITE}/map.pcd, mounted read-only at /map.
MAP_DIR=${HOME}/maps
MAP_SITE=example
